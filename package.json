{
  "name": "ps-cafe-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sqlite": "dotenv -e .env.sqlite -- next dev",
    "build": "next build",
    "build:sqlite": "dotenv -e .env.sqlite -- next build",
    "start": "next start",
    "start:sqlite": "dotenv -e .env.sqlite -- next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:sqlite:generate": "dotenv -e .env.sqlite -- prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:sqlite:push": "dotenv -e .env.sqlite -- prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:sqlite:studio": "dotenv -e .env.sqlite -- prisma studio --schema=prisma/schema.sqlite.prisma",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "effect": "^3.21.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
