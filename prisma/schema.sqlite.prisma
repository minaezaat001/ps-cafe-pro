generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  phone                 String                 @default("")
  passwordHash          String
  trialStartDate        DateTime               @default(now())
  trialEndDate          DateTime
  isSubscribed          Boolean                @default(false)
  isOnboarded           Boolean                @default(false)
  createdAt             DateTime               @default(now())
  users                 User[]
  devices               Device[]
  sessions              Session[]
  inventoryItems        InventoryItem[]
  orders                Order[]
  sales                 Sale[]
  saleItems             SaleItem[]
  deviceTypes           DeviceType[]
  financialTransactions FinancialTransaction[]
  sessionSegments       SessionSegment[]
  shifts                Shift[]
  appSettings           AppSetting[]
  tenantSettings        TenantSettings?
  auditLogs             AuditLog[]
  announcements         SystemAnnouncement[]
  pricingTiers          PricingTier[]
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique
  password              String
  role                  String
  permissions           String?
  tokenVersion          Int                    @default(0)
  tenantId              String?
  tenant                Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialTransactions FinancialTransaction[]
  sales                 Sale[]
  endedSessions         Session[]              @relation("EndedBy")
  sessions              Session[]              @relation("StartedBy")
  openedShifts          Shift[]                @relation("ShiftOpened")
  closedShifts          Shift[]                @relation("ShiftClosed")
  auditLogs             AuditLog[]

  @@index([tenantId, role])
}

model Device {
  id               String    @id @default(cuid())
  number           String
  type             String
  hourlyRateSingle Float @default(0)
  hourlyRateMulti  Float @default(0)
  isDeleted        Boolean @default(false)
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions         Session[]
  @@unique([tenantId, number])
  @@index([tenantId])
}

model Session {
  id                    String    @id @default(cuid())
  deviceId              String
  userId                String
  endedByUserId         String?
  startTime             DateTime  @default(now())
  endTime               DateTime?
  type                  String
  durationMinutes       Int?
  isMulti               Boolean   @default(false)
  isActive              Boolean   @default(true)
  accumulatedTimeCost   Float @default(0)
  accumulatedSingleCost Float @default(0)
  accumulatedMultiCost  Float @default(0)
  lastRateChangeTime    DateTime  @default(now())
  lastHeartbeat         DateTime  @default(now())
  shiftId               String?
  tenantId              String?
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segments              SessionSegment[]
  orders                Order[]
  endedByUser           User?     @relation("EndedBy", fields: [endedByUserId], references: [id])
  user                  User      @relation("StartedBy", fields: [userId], references: [id])
  device                Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  shift                 Shift?    @relation(fields: [shiftId], references: [id])

  @@index([tenantId, isActive, lastHeartbeat])
  @@index([tenantId, startTime])
}

model InventoryItem {
  id       String     @id @default(cuid())
  name     String
  category String
  price    Float @default(0)
  stock    Int
  isActive Boolean    @default(true)
  tenantId String?
  tenant   Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders   Order[]
  sales    SaleItem[]
}

model Order {
  id              String        @id @default(cuid())
  sessionId       String
  inventoryItemId String
  quantity        Int
  priceAtTime     Float
  status          String        @default("DELIVERED")
  createdAt       DateTime      @default(now())
  shiftId         String?
  tenantId        String?
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  deletedByUserId String?
  deletionReason  String?
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shift           Shift?        @relation(fields: [shiftId], references: [id])

  @@index([tenantId, shiftId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Sale {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  totalAmount     Float @default(0)
  userId          String?
  shiftId         String?
  tenantId        String?
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedByUserId String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id])
  items           SaleItem[]
  shift           Shift?    @relation(fields: [shiftId], references: [id])

  @@index([tenantId, createdAt])
}

model SaleItem {
  id              String        @id @default(cuid())
  saleId          String
  inventoryItemId String
  quantity        Int
  priceAtTime     Float
  tenantId        String?
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model DeviceType {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("blue")
  icon      String   @default("Gamepad2")
  createdAt DateTime @default(now())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, name])
  @@index([tenantId])
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  description String
  userId      String
  shiftId     String
  createdAt   DateTime @default(now())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  shift       Shift    @relation(fields: [shiftId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, type])
}

model SessionSegment {
  id           String   @id @default(cuid())
  sessionId    String
  deviceName   String
  deviceType   String
  mode         String
  startTime    DateTime
  endTime      DateTime
  durationMins Float
  cost         Float @default(0)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Shift {
  id                    String                 @id @default(cuid())
  openedAt              DateTime               @default(now())
  closedAt              DateTime?
  openedByUserId        String
  closedByUserId        String?
  openingFloat          Float  @default(0)
  expectedCash          Float  @default(0)
  actualCash            Float?
  variance              Float?
  notes                 String?
  status                String                 @default("OPEN")
  tenantId              String?
  tenant                Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedByUser          User                   @relation("ShiftOpened", fields: [openedByUserId], references: [id])
  closedByUser          User?                  @relation("ShiftClosed", fields: [closedByUserId], references: [id])
  sessions              Session[]
  orders                Order[]
  sales                 Sale[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([tenantId, closedAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  reason        String
  metadata      String   @default("{}")
  tenantId      String?
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model TenantSettings {
  id            String   @id @default(cuid())
  currency      String   @default("EGP")
  currencySymbol String   @default("ج.م")
  timezone      String   @default("Africa/Cairo")
  updatedAt     DateTime @updatedAt
  
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PricingTier {
  id          String   @id @default(cuid())
  name        String
  startTime   String?
  endTime     String?
  dayOfWeek   Int?
  multiplier  Float  @default(1.0)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model SystemAnnouncement {
  id        String   @id @default(cuid())
  message   String
  type      String   @default("INFO")
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([isActive, createdAt, tenantId])
}
